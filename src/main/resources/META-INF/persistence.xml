<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Nombre de la unidad de persistencia: laboratorioPU -->
    <persistence-unit name="laboratorioPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.appregistro.model.TipoEquipo</class>
        <class>com.example.appregistro.model.Equipo</class>

        <properties>
            <!-- Conexión local a PostgreSQL (usuario y clave del laboratorio).
                 Si existen las variables de entorno DB_URL / DB_USER / DB_PASSWORD,
                 JPAUtil las usa en lugar de estos valores. -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/bd_laboratorio_orm"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="luzmia2007@"/>

            <!-- Esquema por defecto donde están las tablas -->
            <property name="hibernate.default_schema" value="laboratorio"/>

            <!-- Criterio de administración del esquema:
                 validate = Hibernate NO crea ni borra tablas; solo comprueba que
                 las entidades coincidan con lo creado por el script SQL. -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Mostrar el SQL que genera Hibernate (útil para la demostración) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
